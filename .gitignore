# Local editor/launch config
.claude/

# Full-size camera originals: only exported web copies are published
images/og/*
!images/og/share.jpg
images/casa/_DSC*
images/casa/Antes_*
images/casa/Después_*
images/casa/Gemini_*
images/casa/pexels-*
images/brands/fiel.esmx/*
!images/brands/fiel.esmx/web/
# Fiel: originales de cámara (JPG, ARW), Antes/Después, Ai_ y Stock de Pexels; solo se publica web/
images/fiel.esmx/*
!images/fiel.esmx/web/
# Justo: solo las fotos que usan las páginas (ya versionadas); una nueva se sube con git add -f
images/justo.esmx/*

# Documentación interna (tienda Justo, decisiones, riesgos): nunca en el repositorio ni en el sitio
_interno/

# Estudios internos de precios de Fiel (PDF, HTML y generador): solo locales, nunca en el sitio
docs/ajustes-fiel-*
docs/src/ajustes-fiel*

# Ruta común de Lameyer: el documento interno nunca va al repositorio ni al sitio (el de _clientes/ es público)
brands/builds/sites/_plataforma/

# Estrategia SEO de Justo (trajes a la medida, club de membresía): PDF y fuente solo locales, nunca en el sitio
docs/seo-justo-*
docs/src/seo-justo-*

# Fuentes de las pantallas de carga: demo / uso personal, nunca en el repositorio hasta comprar la licencia (cargando/fonts/README.md)
cargando/fonts/*
!cargando/fonts/README.md

# Python bytecode of the generators in docs/src/
__pycache__/

# Secretos: claves de Supabase, Odoo y Turnstile. Solo .env.example (sin valores) entra al repositorio.
# Los valores públicos que necesita el navegador los copia tools/env-a-config.py a js/supabase-config.js.
.env
.env.*
!.env.example
*.pem
*.key
supabase/.temp/
supabase/.branches/

# Dependencias de las herramientas locales (package.json sí entra)
node_modules/

# Fijo: originales de Gemini fuera del repo; solo web/ y el README
images/fijo/*
!images/fijo/web/
!images/fijo/README.md
