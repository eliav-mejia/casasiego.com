# Casa Siego · variables de entorno. Copiar a .env (ignorado por Git) y llenar.
# Valores: Supabase → Project Settings → API Keys / JWT Keys. Proyecto propio de Casa Siego (uno por cliente, Etapa 7).
# El sitio es estático (GitHub Pages, sin build): el navegador NO lee este archivo.
#   python3 tools/env-a-config.py   copia SOLO los valores públicos (URL, clave publicable, Turnstile) a js/supabase-config.js

# --- Supabase · públicos (van al navegador) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
TURNSTILE_SITE_KEY=

# --- Supabase · secretos (nunca en el navegador ni en Git) ---
# Salta RLS. Solo herramientas locales; las Edge Functions la reciben de la plataforma.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=
TURNSTILE_SECRET_KEY=

# --- Odoo Inventario → Supabase (Edge Function odoo-existencias) ---
# Se cargan como secretos de la función:  npx supabase secrets set --env-file .env
ODOO_URL=https://<empresa>.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
# IDs de stock.warehouse: México (CDMX) y España (Madrid)
ODOO_ALMACEN_MX=
ODOO_ALMACEN_ES=
# Secreto compartido: la acción automatizada de Odoo lo manda en la cabecera x-odoo-secreto
ODOO_WEBHOOK_SECRET=

# --- Opcional: proveedores OAuth (supabase/config.toml, CLI local) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# SMTP propio (Authentication → SMTP; config.toml lo lee solo en la CLI local)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
